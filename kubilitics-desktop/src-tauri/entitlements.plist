<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri-2 / WKWebView hardened-runtime entitlements.
       allow-jit and allow-unsigned-executable-memory are required by
       WebKit's JavaScript engine (Nitro JIT) running inside WKWebView.
       Without them, WKWebView falls back to a slow interpreter and the
       UI is sluggish or fails to render complex pages.

       disable-library-validation is intentionally NOT present: the Go
       sidecar binaries are CGO_ENABLED=0 (fully static) and Apple's
       WKWebView / Tauri frameworks are all Apple-signed. There is no
       need to bypass library validation, and keeping it absent avoids
       Gatekeeper flagging on macOS 13+.

       The sidecar binaries (kubilitics-backend, kubilitics-ai-server,
       kcli) are signed separately with entitlements-sidecar.plist which
       has no JIT entitlements. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Load-bearing: scopes our keychain entries to the team prefix.
       Without this, the keychain ACL is bound to binary hash and
       users hit the "enter login password" dialog on every release
       update. With it, the ACL is bound to TeamIdentifier+bundle ID
       so a single "Always Allow" persists across every future update. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.kubilitics.desktop</string>
  </array>
</dict>
</plist>
