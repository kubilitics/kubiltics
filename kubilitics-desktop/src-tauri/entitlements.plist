<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri-2 / WKWebView hardened-runtime entitlements.
       allow-jit is required for WKWebView's JavaScript engine (Nitro JIT).
       On macOS 14+, WKWebView runs JS in a separate Apple-signed WebContent
       process that manages its own JIT permissions — the host app only needs
       allow-jit. allow-unsigned-executable-memory is NOT needed and is
       BLOCKED by macOS 26 (Tahoe) policy for Developer ID apps with
       Hardened Runtime — keeping it causes NSPOSIXErrorDomain Code=163
       "Launchd job spawn failed" on macOS 26.

       The sidecar binaries (kubilitics-backend, kubilitics-ai-server,
       kcli) are signed separately with entitlements-sidecar.plist which
       has no JIT entitlements. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- keychain-access-groups intentionally absent: on macOS 26 (Tahoe)
       this entitlement triggers NSPOSIXErrorDomain Code=163 "Launchd job
       spawn failed" for Developer ID apps without a provisioning profile.
       Keychain still works for storing AI credentials — items are scoped
       by the app's bundle ID automatically. -->
</dict>
</plist>
