# ── False-positive exclusions ─────────────────────────────────────────────────
# Each entry below is a path where a semgrep rule fires but does not represent
# a real vulnerability. The reason is documented inline.

# go.lang.security.audit.xss.no-direct-write-to-responsewriter
# go.lang.security.audit.xss.no-fprintf-to-responsewriter
# These files write application/json or SSE (text/event-stream) responses with
# explicit Content-Type headers. XSS is not possible when Content-Type is not
# text/html. json.NewEncoder(w) is the recommended safe Go JSON pattern.
kubilitics-backend/internal/events/sse.go
kubilitics-backend/internal/api/rest/presence_handler.go
kubilitics-backend/internal/api/rest/reports_handler.go
kubilitics-backend/internal/api/rest/kubeconfig.go
kubilitics-backend/internal/api/rest/file_transfer.go
kubilitics-backend/internal/api/rest/addons.go
kubilitics-backend/internal/api/rest/handler.go
kubilitics-backend/internal/api/rest/scanner_handler.go
kubilitics-backend/internal/api/rest/tracing_install.go
kubilitics-backend/internal/api/websocket/handler.go
kubilitics-backend/internal/api/middleware/auth.go
kubilitics-backend/internal/api/rest/saml.go
brain/internal/server/server.go
kubilitics-trace-agent/internal/receiver/receiver.go
kubilitics-trace-agent/cmd/demo-app/main.go

# go.lang.security.audit.dangerous-exec-command
# kubilitics-cli is a terminal UI that delegates to kubectl/shell tools.
# exec.Command is used with array arguments (no shell interpretation).
# Binary paths are validated via exec.LookPath before invocation.
kubilitics-cli/internal/ui/tui.go
kubilitics-cli/internal/ui/portforward.go
kubilitics-cli/internal/ui/exec.go
kubilitics-cli/internal/runner/kubectl.go
kubilitics-cli/internal/plugin/sandbox.go
kubilitics-cli/internal/kubectl/passthrough.go
kubilitics-cli/internal/cli/config.go

# go.lang.security.bad_tmp.bad-tmp-file-creation
# /tmp/kubilitics-backend.port is an IPC rendezvous file containing only a
# port number (no secrets). Permissions 0o600, process-owned directory.
kubilitics-backend/cmd/server/main.go

# go.lang.security.audit.xss.import-text-template
# text/template is used in CLI log formatting (stdout output, not HTTP).
# No HTML context, no XSS vector.
kubilitics-cli/internal/cli/logs.go

# go.lang.security.injection.open-redirect
# Redirect URL is constructed by the crewjam/saml library from server-configured
# IdP metadata. relayState does not control the redirect host.
# (already covered above via saml.go path)

# javascript.lang.security.audit.detect-non-literal-regexp
# Frontend uses dynamic regex only for filtering/searching display data.
# Regex injection is not a security vulnerability in this context.
kubilitics-frontend/src/pages/StatefulSetDetail.tsx

# javascript.lang.security.audit.prototype-pollution.prototype-pollution-loop
# dig() helper traverses K8s API objects (trusted, schema-validated).
# Type guards (typeof check + null check) prevent prototype chain abuse.
kubilitics-frontend/src/hooks/useClusterWatcher.ts
kubilitics-frontend/src/topology/export/exportCSV.ts

# javascript.lang.security.audit.path-traversal.path-join-resolve-traversal
# Paths come from readdirSync() output and hardcoded filenames — no user input.
kubilitics-frontend/src/lib/removeLegacyDeps.ts

# go.lang.security.audit.net.use-tls / go.grpc.security.grpc-server-insecure-connection
# Test stubs and local demo apps that run only on loopback (127.0.0.1).
