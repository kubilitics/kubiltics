# KOTG.AI Environment Configuration
# Copy to .env and customize
#
# Development modes:
#   A) SSH tunnel to EC2:  KOTG_OLLAMA_BASE_URL=http://localhost:11434 (tunnel forwards EC2 port)
#   B) Direct EC2 access:  KOTG_OLLAMA_BASE_URL=http://<EC2_PUBLIC_IP>:11434
#   C) Local Docker:       KOTG_OLLAMA_BASE_URL=http://localhost:11434 (local docker-compose)

# ── Ollama (local or remote via SSH tunnel) ───────────────────────────────────
KOTG_OLLAMA_BASE_URL=http://localhost:11434
KOTG_OLLAMA_TIMEOUT=120
KOTG_OLLAMA_MAX_RETRIES=3

# ── EC2 remote endpoint (uncomment for direct access, no SSH tunnel) ──────────
# KOTG_OLLAMA_BASE_URL=http://<EC2_PUBLIC_IP>:11434

# ── Model tiers (matches ec2-setup.sh pulled models) ─────────────────────────
KOTG_MODEL_NANO_MODEL=qwen2.5:0.5b
KOTG_MODEL_SMALL_MODEL=qwen2.5-coder:7b-instruct-q4_k_m
KOTG_MODEL_MEDIUM_MODEL=qwen2.5:7b-instruct-q4_k_m
KOTG_MODEL_LARGE_MODEL=qwen2.5:7b-instruct-q4_k_m
KOTG_MODEL_EXPERT_MODEL=qwen2.5:7b-instruct-q4_k_m
KOTG_MODEL_EMBEDDING_MODEL=nomic-embed-text

# ── Qdrant (vector DB) ───────────────────────────────────────────────────────
KOTG_QDRANT_URL=http://localhost:6333
# KOTG_QDRANT_URL=http://<EC2_PUBLIC_IP>:6333   # direct EC2 access
KOTG_QDRANT_COLLECTION_NAME=kotg_knowledge
# KOTG_QDRANT_API_KEY=your-qdrant-cloud-key     # only for Qdrant Cloud

# ── Kubernetes ───────────────────────────────────────────────────────────────
# KOTG_KUBE_CONFIG_PATH=~/.kube/config
# KOTG_KUBE_CONTEXT=my-cluster-context
KOTG_KUBE_IN_CLUSTER=false

# ── App settings ─────────────────────────────────────────────────────────────
KOTG_DEBUG=false
KOTG_LOG_LEVEL=INFO
KOTG_DATA_DIR=~/.kotg
KOTG_API_PORT=8080

# ── Optional cloud LLM fallback (not required for local use) ─────────────────
# KOTG_OPENAI_API_KEY=sk-...
# KOTG_ANTHROPIC_API_KEY=sk-ant-...
