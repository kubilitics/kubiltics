# Kubilitics Frontend — Production Environment
# Values here are applied in Vite production builds. Local dev should use
# .env.local; developer-only overrides go in .env (untracked).

# -----------------------------------------------------------------------------
# Feature Flags — onboarding-v2 rollout
# -----------------------------------------------------------------------------

# Cluster Presence Layer (onboarding-v2).
# Phase 6 (2026-04-24) flipped the default on in code. Setting it explicitly
# here future-proofs production builds against any later default change, and
# it's trivially auditable at build time.
# To roll back without rebuilding, use the localStorage override:
#   localStorage.setItem('kubilitics.feature.presenceV2', 'false')
VITE_FEATURE_PRESENCE_V2=true
