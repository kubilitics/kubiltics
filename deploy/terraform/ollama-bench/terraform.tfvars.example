region        = "us-east-1"
instance_type = "t3.large"           # 2 vCPU / 8 GiB RAM, CPU-only, ~$0.083/hr
models        = ["qwen2.5:3b"]       # ~2 GB, snappy on CPU
# allowed_cidr   = "203.0.113.42/32" # auto-detected via checkip.amazonaws.com if empty
# volume_size_gb = 30                # bump to 60 if pulling 7B+ models too
# instance_type  = "t3.xlarge"       # 4 vCPU / 16 GiB → fits 7B models
# instance_type  = "g5.xlarge"       # GPU (NVIDIA A10G), ~$1/hr → for production-speed iteration
